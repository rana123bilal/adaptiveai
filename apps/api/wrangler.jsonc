{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "adaptiveai-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": ["enable_request_signal"],
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173",
    "DEMO_ENABLED": "false"
  }
}
